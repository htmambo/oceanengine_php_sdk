# 巨量引擎开放平台应用凭证：复制本文件为 .env 后填写真实值（.env 不会被提交）
APP_ID=1234567890
SECRET=your_app_secret

# 可选：指定广告主（不填则用授权列表首个；配置后优先于授权列表）
# ADVERTISER_ID=999888777
# 可选：广告主授权回调带回的 auth_code（换取「广告主级 access_token」，业务接口应使用该 token）
#      获取路径：在开放平台完成广告主授权后，从回调参数中取 auth_code
#      开发者快速入门见 https://open.oceanengine.com/labels/7/docs/1696710498372623
# AUTH_CODE=
# 可选：账户 ID 列表（逗号分隔；不填则跳过"账户余额"场景）
# ACCOUNT_IDS=123456789
# 可选：报表日期区间（默认最近 7 天，截止昨天）
# START_DATE=2026-10-16
# END_DATE=2026-10-22
# 可选：API 地址（本地联调指向 mock 时用）
# API_HOST=api.oceanengine.com
# API_SCHEME=https
# 可选：单请求超时秒数
# TIMEOUT=60
# 可选：设为 1 时缺少凭证直接以退出码 2 结束（CI 严格模式）
# STRICT=0

# 可选：账户余额接口的账户类型（AD / STAR / LOCAL / QIANCHUAN，默认 AD）
# ACCOUNT_TYPE=AD
# 可选：广告报表返回字段（逗号分隔，默认 cost,click,convert）
# REPORT_FIELDS=cost,click,convert
# 可选：指定 .env 文件路径（默认按 包根 → 上级目录 顺序查找）
# OCEANENGINE_ENV_FILE=/path/to/.env
